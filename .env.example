# UniVPN 容器配置模板。复制成 .env 使用: cp .env.example .env
# docker compose 会自动读 .env, 改完执行 docker compose up -d --build 生效

# ---- 客户端版本 ----
# 公网上有 10781.19.0.1214 / 10781.21.0.0831 两个官方包;
# 想用别的版本就把官方 zip 放进 assets/, 然后改这里(见 docs/usage.md)
CLIENT_VERSION=10781.21.0.0831
# 安装包直链, 一般留空
CLIENT_ZIP_URL=

# ---- 建议改 ----
# noVNC / VNC 的登录密码
VNC_PASSWORD=univpn

# 服务端如果校验客户端 MAC, 这里填被绑定的那个 MAC; 不需要就留默认
SPOOF_MAC=02:42:ac:11:00:01

# ---- 可选 ----
# 桌面分辨率。VPN 客户端界面很简单, 不需要太大(noVNC 传的是画面, 大了费流量和 CPU)
VNC_RESOLUTION=1024x768

# 断线自动重连: 每 10 秒 ping 一次 RECONNECT_PING_TARGET, ping 不通就重启客户端。
# 注意: 如果 VPN 连上后这个目标根本 ping 不通, 客户端会被反复重启, 所以默认关着。
AUTO_RECONNECT=false
RECONNECT_PING_TARGET=1.1.1.1
# 启动后留给你登录(账号/密码/短信)的时间
RECONNECT_GRACE_PERIOD=60

# 客户端拨上号之后创建的 VPN 网卡名, SOCKS5 代理拿它当出口。
# 不确定就先用默认值, 连上之后进容器看: docker compose exec univpn ip -br link
DANTE_INTERFACE=cnem_vnic

# ---- 构建相关 ----
# 国内构建慢可以设成 mirrors.tuna.tsinghua.edu.cn 之类
APT_MIRROR=
TZ=Asia/Shanghai